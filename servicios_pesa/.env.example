# ══════════════════════════════════════════════════════════════════════════════
# Servicios PESA (escritorio) — plantilla de variables de entorno
# Copia este archivo a `.env` (NO se sube a GitHub) y llena los valores reales.
# Ubicaciones que lee la app (la primera que exista gana):
#   macOS   : ~/Library/Application Support/PesaServicios/.env
#   Windows : %APPDATA%\PesaServicios\.env  o  junto al .exe
#   Dev     : servicios_pesa/.env
# ══════════════════════════════════════════════════════════════════════════════

# ─── Base de datos (Render PostgreSQL) ─────────────────────────────────────────
PESA_DB_HOST=dpg-xxxxxxxxxxxxxxxxxxxx-a.oregon-postgres.render.com
PESA_DB_PORT=5432
PESA_DB_NAME=pesa_db
PESA_DB_USER=pesa_user
PESA_DB_PASSWORD=
PESA_DB_SSLMODE=require

# Alternativa: una sola cadena (tiene prioridad sobre PESA_DB_*)
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require

# ─── API (Render) ─────────────────────────────────────────────────────────────
PESA_API_URL=https://pesa-api-za9i.onrender.com

# ─── Rutas de archivos ────────────────────────────────────────────────────────
PESA_FILES_PATH=

# ─── Logging: DEBUG, INFO, WARNING, ERROR ─────────────────────────────────────
PESA_LOG_LEVEL=INFO
