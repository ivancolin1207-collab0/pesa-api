# Variables de entorno para Servicios PESA
# Copiar este archivo a .env y configurar los valores reales

# ─── Base de Datos ─────────────────────────────────────────────────────────────
PESA_DB_HOST=192.168.100.1
PESA_DB_PORT=5432
PESA_DB_NAME=servicios_pesa
PESA_DB_USER=pesa_app
PESA_DB_PASSWORD=TU_CONTRASENA_AQUI

# ─── Rutas de Archivos (ruta UNC o letra de unidad mapeada) ───────────────────
PESA_FILES_PATH=\\SERVIDOR-PESA\Archivos

# ─── Nivel de Logging ─────────────────────────────────────────────────────────
# Opciones: DEBUG, INFO, WARNING, ERROR
PESA_LOG_LEVEL=INFO
