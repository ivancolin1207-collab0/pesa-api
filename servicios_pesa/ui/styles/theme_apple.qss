/* ============================================================================
   BÁSCULAS PESA -- theme_apple.qss (Diseño Corporativo Minimalista)
   Paleta estricta sin colores pastel/IA:
     Fondo general y tablas:     #FFFFFF (Blanco puro)
     Superficies neutras:        #F8FAFC
     Bordes y divisores:         1px solid #E2E8F0 / #CBD5E1
     Texto primario:             #0F172A (Negro carbón)
     Texto secundario:           #475569 (Gris pizarra)
     Único acento corporativo:   #C8102E (Hover #A50D26)
============================================================================ */

QMainWindow,
QDialog,
QWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
}

QMainWindow::separator {
    width: 0px;
    height: 0px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover   { background: #94A3B8; }
QScrollBar::handle:vertical:pressed { background: #64748B; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none; border: none; height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover   { background: #94A3B8; }
QScrollBar::handle:horizontal:pressed { background: #64748B; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none; border: none; width: 0px;
}

/* ============================================================================
   BARRA LATERAL (SIDEBAR)
============================================================================ */
QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

QLabel#brand_title {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brand_subtitle {
    color: #475569;
    font-size: 11px;
}

QLabel#sidebar_section {
    color: #64748B;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding-left: 16px;
    padding-top: 10px;
    padding-bottom: 4px;
    text-transform: uppercase;
}

QPushButton#nav_btn {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0 12px 0 14px;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 8px;
    height: 40px;
}

QPushButton#nav_btn:hover {
    background-color: #F8FAFC;
    color: #0F172A;
}

QPushButton#nav_btn[active="true"] {
    background-color: #F8FAFC;
    color: #C8102E;
    border-left: 3px solid #C8102E;
    font-weight: 700;
}

QFrame#user_chip {
    background-color: #F8FAFC;
    border-radius: 8px;
    border: 1px solid #E2E8F0;
}

QLabel#user_name {
    color: #0F172A;
    font-size: 12px;
    font-weight: 600;
}

QLabel#user_role {
    color: #475569;
    font-size: 10px;
    font-weight: 500;
}

QFrame#sidebar_sep {
    background-color: #E2E8F0;
    border: none;
    margin: 4px 12px;
    max-height: 1px;
}

/* ============================================================================
   ENCABEZADO Y TARJETAS KPI
============================================================================ */
QWidget#content_header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QLabel#page_title {
    color: #0F172A;
    font-size: 20px;
    font-weight: 700;
}

QLabel#page_subtitle,
QLabel#breadcrumb {
    color: #475569;
    font-size: 13px;
    font-weight: 600;
}

QFrame#kpi_card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame#filter_bar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame#segmented_control {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 2px;
}

QPushButton#seg_btn {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    min-height: 28px;
}

QPushButton#seg_btn:checked {
    background-color: #C8102E;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#seg_btn:hover:!checked {
    background-color: #F1F5F9;
    color: #0F172A;
}

/* ============================================================================
   CONTROLES DE ENTRADA
============================================================================ */
QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding-left: 10px;
    padding-right: 24px;
    min-height: 36px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #94A3B8;
}

QComboBox:focus {
    border: 1.5px solid #C8102E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left-width: 0px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #475569;
    margin-right: 4px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #F8FAFC;
    selection-color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 34px;
    font-size: 13px;
    selection-background-color: #E2E8F0;
    selection-color: #0F172A;
}

QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #C8102E;
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #94A3B8;
}

/* ============================================================================
   TABLAS Y LISTADOS CORPORATIVOS
============================================================================ */
QTableWidget, QTreeWidget, QTableView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    outline: none;
    gridline-color: transparent;
    font-size: 13px;
}

QTreeWidget::item, QTableWidget::item, QTableView::item {
    background-color: #FFFFFF;
    color: #0F172A;
    padding: 0px 10px;
    min-height: 48px;
    border-bottom: 1px solid #E2E8F0;
    font-size: 12.5px;
}

QTreeWidget::item:hover, QTableWidget::item:hover, QTableView::item:hover {
    background-color: #F8FAFC;
}

QTreeWidget::item:selected, QTableWidget::item:selected, QTableView::item:selected {
    background-color: #F8FAFC;
    color: #0F172A;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 0px 10px;
    height: 40px;
    min-height: 40px;
}

/* ============================================================================
   BOTONES CORPORATIVOS
============================================================================ */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12.5px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border: 1px solid #E2E8F0;
}

QPushButton[class="primary"], QPushButton#btn_primary {
    background-color: #C8102E;
    color: #FFFFFF;
    border: 1px solid #C8102E;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[class="primary"]:hover, QPushButton#btn_primary:hover {
    background-color: #A50D26;
    border-color: #A50D26;
}

QPushButton#btn_action_pdf,
QPushButton#btn_action_edit,
QPushButton#btn_action_more {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 11.5px;
    font-weight: 600;
    min-height: 28px;
}

QPushButton#btn_action_pdf:hover,
QPushButton#btn_action_edit:hover,
QPushButton#btn_action_more:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

/* ============================================================================
   MENÚS Y BARRA DE ESTADO
============================================================================ */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 4px;
    font-size: 13px;
}

QMenu::item {
    padding: 7px 16px;
    border-radius: 4px;
    color: #0F172A;
}

QMenu::item:selected {
    background-color: #F8FAFC;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 4px 8px;
}

QStatusBar {
    background: #FFFFFF;
    color: #475569;
    border-top: 1px solid #E2E8F0;
    font-size: 11px;
    padding: 2px 8px;
}

QToolTip {
    background-color: #0F172A;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}
