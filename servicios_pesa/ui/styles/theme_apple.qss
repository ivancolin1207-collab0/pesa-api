/* ============================================================================
   BÁSCULAS PESA -- theme_apple.qss (Apple Minimalist macOS Sequoia v3.3.1)
   Reglas anti-fuga QSS:
     - QLabel sin borde ni fondo por defecto.
     - Ningún selector genérico de contenedor QFrame/QWidget sobreescribe hijos.
     - SVG vectoriales para ComboBox y SpinBox (Fusion light palette).
   Paleta estricta Apple Minimalista (cero colores pastel/IA, cero fondos rosados):
     Canvas / fondo principal:   #F5F5F7 (Apple System Gray 6)
     Superficies / tarjetas:     #FFFFFF
     Superficies neutras/hover:  #F2F2F7
     Bordes y divisores:         #E5E5EA / #D2D2D7 / #F2F2F7
     Texto primario:             #1D1D1F
     Texto secundario:           #6E6E73
     Texto placeholder:          #8E8E93
     Único acento corporativo:   #C8102E (Hover #A60D26, Pressed #880B20)
============================================================================ */

QMainWindow,
QDialog {
    background-color: #F5F5F7;
    color: #1D1D1F;
    font-family: "Segoe UI Variable", "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
}

QLabel {
    border: none;
    background-color: transparent;
    color: #1D1D1F;
}

QMainWindow::separator {
    width: 0px;
    height: 0px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D2D2D7;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover   { background: #8E8E93; }
QScrollBar::handle:vertical:pressed { background: #6E6E73; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none; border: none; height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #D2D2D7;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover   { background: #8E8E93; }
QScrollBar::handle:horizontal:pressed { background: #6E6E73; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none; border: none; width: 0px;
}

/* ============================================================================
   BARRA LATERAL (SIDEBAR 232px — macOS Finder/Settings)
============================================================================ */
QWidget#sidebar {
    background-color: #FBFBFD;
    border-right: 1px solid #E5E5EA;
}

QLabel#brand_title {
    color: #1D1D1F;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brand_subtitle {
    color: #6E6E73;
    font-size: 11px;
}

QLabel#sidebar_section {
    color: #8E8E93;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding-left: 16px;
    padding-top: 10px;
    padding-bottom: 4px;
    text-transform: uppercase;
}

QPushButton#nav_btn {
    background-color: transparent;
    color: #6E6E73;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 0 12px 0 14px;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 8px;
    height: 40px;
}

QPushButton#nav_btn:hover {
    background-color: #F2F2F7;
    color: #1D1D1F;
}

QPushButton#nav_btn[active="true"] {
    background-color: #F2F2F7;
    color: #C8102E;
    border-left: 3px solid #C8102E;
    font-weight: 700;
}

QFrame#user_chip {
    background-color: #F2F2F7;
    border-radius: 10px;
    border: 1px solid #E5E5EA;
}

QLabel#user_name {
    color: #1D1D1F;
    font-size: 12px;
    font-weight: 600;
}

QLabel#user_role {
    color: #6E6E73;
    font-size: 10.5px;
    font-weight: 500;
}

QFrame#sidebar_sep {
    background-color: #E5E5EA;
    border: none;
    margin: 4px 12px;
    max-height: 1px;
}

/* ============================================================================
   ENCABEZADO (56px) Y TARJETAS KPI (14px radius)
============================================================================ */
QWidget#content_header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E5EA;
}

QLabel#page_title {
    color: #1D1D1F;
    font-size: 20px;
    font-weight: 700;
}

QLabel#page_subtitle,
QLabel#breadcrumb {
    color: #1D1D1F;
    font-size: 15px;
    font-weight: 700;
}

QFrame#kpi_card,
QFrame#filter_bar,
QFrame[card="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 14px;
}

QFrame#segmented_control {
    background-color: #F2F2F7;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
    padding: 2px;
}

QPushButton#seg_btn {
    background-color: transparent;
    color: #6E6E73;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    min-height: 28px;
}

QPushButton#seg_btn:checked {
    background-color: #C8102E;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#seg_btn:hover:!checked {
    background-color: #E5E5EA;
    color: #1D1D1F;
}

/* ============================================================================
   CONTROLES DE ENTRADA (38px, 10px radius, #D2D2D7 border, SVG icons)
============================================================================ */
QComboBox {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    padding: 0px 30px 0px 12px;
    min-height: 36px;
    max-height: 38px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #8E8E93;
}

QComboBox:focus {
    border: 1.5px solid #C8102E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(ui/assets/icons/chevron_down.svg);
    width: 12px;
    height: 12px;
    border: none;
}

QComboBox QLineEdit {
    min-height: 0px;
    max-height: 36px;
    padding: 0px 2px;
    margin: 0px;
    border: none;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1D1D1F;
    selection-background-color: #F2F2F7;
    selection-color: #1D1D1F;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 4px 10px;
    color: #1D1D1F;
    background-color: #FFFFFF;
    border-radius: 8px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #F2F2F7;
    color: #1D1D1F;
}

QLineEdit, QDateEdit {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    padding: 0px 12px;
    min-height: 36px;
    max-height: 38px;
    font-size: 13px;
    selection-background-color: #E5E5EA;
    selection-color: #1D1D1F;
}

QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    padding: 0px 28px 0px 10px;
    min-width: 112px;
    min-height: 36px;
    max-height: 38px;
    font-size: 13px;
    selection-background-color: #E5E5EA;
    selection-color: #1D1D1F;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E5E5EA;
    border-bottom: 1px solid #E5E5EA;
    border-top-right-radius: 10px;
    background-color: #F2F2F7;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border-left: 1px solid #E5E5EA;
    border-bottom-right-radius: 10px;
    background-color: #F2F2F7;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #E5E5EA;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(ui/assets/icons/arrow_up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(ui/assets/icons/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 76px;
    font-size: 13px;
    selection-background-color: #E5E5EA;
    selection-color: #1D1D1F;
}

QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #C8102E;
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #8E8E93;
}

/* ============================================================================
   TABLAS Y LISTADOS CORPORATIVOS (14px radius, #F2F2F7 dividers)
============================================================================ */
QTableWidget, QTreeWidget, QTableView {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #E5E5EA;
    border-radius: 14px;
    outline: none;
    gridline-color: transparent;
    font-size: 13px;
}

QTreeWidget::item, QTableWidget::item, QTableView::item {
    background-color: #FFFFFF;
    color: #1D1D1F;
    padding: 0px 10px;
    min-height: 50px;
    border-bottom: 1px solid #F2F2F7;
    font-size: 12.5px;
}

QTreeWidget::item:hover, QTableWidget::item:hover, QTableView::item:hover {
    background-color: #F2F2F7;
}

QTreeWidget::item:selected, QTableWidget::item:selected, QTableView::item:selected {
    background-color: #F2F2F7;
    color: #1D1D1F;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #FBFBFD;
    color: #6E6E73;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border: none;
    border-bottom: 1px solid #E5E5EA;
    padding: 0px 10px;
    height: 40px;
    min-height: 40px;
}

/* ============================================================================
   BOTONES CORPORATIVOS (10px radius)
============================================================================ */
QPushButton {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12.5px;
    min-height: 36px;
}

QPushButton:hover {
    background-color: #F2F2F7;
    border-color: #8E8E93;
}

QPushButton:pressed {
    background-color: #E5E5EA;
}

QPushButton:disabled {
    background-color: #F2F2F7;
    color: #8E8E93;
    border: 1px solid #E5E5EA;
}

QPushButton[class="primary"], QPushButton[variant="primary"], QPushButton#btn_primary {
    background-color: #C8102E;
    color: #FFFFFF;
    border: 1px solid #C8102E;
    border-radius: 10px;
    font-weight: 600;
}

QPushButton[class="primary"]:hover, QPushButton[variant="primary"]:hover, QPushButton#btn_primary:hover {
    background-color: #A60D26;
    border-color: #A60D26;
}

QPushButton[variant="secondary"] {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 10px;
    font-weight: 600;
}

QPushButton#btn_action_pdf,
QPushButton#btn_action_edit,
QPushButton#btn_action_more {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D7;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11.5px;
    font-weight: 600;
    min-height: 28px;
}

QPushButton#btn_action_pdf:hover,
QPushButton#btn_action_edit:hover,
QPushButton#btn_action_more:hover {
    background-color: #F2F2F7;
    border-color: #8E8E93;
}

/* ============================================================================
   MENÚS Y BARRA DE ESTADO
============================================================================ */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 10px;
    padding: 4px;
    font-size: 12.5px;
}

QMenu::item {
    padding: 7px 14px;
    border-radius: 8px;
    color: #1D1D1F;
}

QMenu::item:selected {
    background-color: #F2F2F7;
}

QMenu::separator {
    height: 1px;
    background-color: #F2F2F7;
    margin: 4px 8px;
}

QStatusBar {
    background: #FFFFFF;
    color: #6E6E73;
    border-top: 1px solid #E5E5EA;
    font-size: 11px;
    padding: 2px 10px;
}

QToolTip {
    background-color: #1D1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
}
