/* ============================================================================
   BÁSCULAS PESA -- theme_apple.qss (Diseño Corporativo Minimalista v3.2)
   Paleta estricta sin colores pastel/IA:
     Canvas / fondo principal:   #F6F7F9
     Superficies / tarjetas:     #FFFFFF
     Superficies neutras:        #F8FAFC / #F9FAFB
     Bordes y divisores:         1px solid #E5E7EB / #CBD5E1 / #F3F4F6
     Texto primario:             #111827
     Texto secundario:           #6B7280
     Texto terciario:            #9CA3AF
     Único acento corporativo:   #C8102E (Hover #A60D26)
============================================================================ */

QMainWindow,
QDialog {
    background-color: #F6F7F9;
    color: #111827;
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
}

QWidget {
    color: #111827;
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
}

QMainWindow::separator {
    width: 0px;
    height: 0px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover   { background: #9CA3AF; }
QScrollBar::handle:vertical:pressed { background: #6B7280; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none; border: none; height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover   { background: #9CA3AF; }
QScrollBar::handle:horizontal:pressed { background: #6B7280; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none; border: none; width: 0px;
}

/* ============================================================================
   BARRA LATERAL (SIDEBAR)
============================================================================ */
QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

QLabel#brand_title {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}

QLabel#brand_subtitle {
    color: #6B7280;
    font-size: 11px;
}

QLabel#sidebar_section {
    color: #9CA3AF;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding-left: 16px;
    padding-top: 10px;
    padding-bottom: 4px;
    text-transform: uppercase;
}

QPushButton#nav_btn {
    background-color: transparent;
    color: #6B7280;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 0 12px 0 14px;
    font-size: 13px;
    font-weight: 500;
    margin: 2px 8px;
    height: 40px;
}

QPushButton#nav_btn:hover {
    background-color: #F8FAFC;
    color: #111827;
}

QPushButton#nav_btn[active="true"] {
    background-color: #F8FAFC;
    color: #C8102E;
    border-left: 3px solid #C8102E;
    font-weight: 700;
}

QFrame#user_chip {
    background-color: #F8FAFC;
    border-radius: 10px;
    border: 1px solid #E5E7EB;
}

QLabel#user_name {
    color: #111827;
    font-size: 12px;
    font-weight: 600;
}

QLabel#user_role {
    color: #6B7280;
    font-size: 10.5px;
    font-weight: 500;
}

QFrame#sidebar_sep {
    background-color: #E5E7EB;
    border: none;
    margin: 4px 12px;
    max-height: 1px;
}

/* ============================================================================
   ENCABEZADO Y TARJETAS KPI
============================================================================ */
QWidget#content_header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

QLabel#page_title {
    color: #111827;
    font-size: 20px;
    font-weight: 700;
}

QLabel#page_subtitle,
QLabel#breadcrumb {
    color: #111827;
    font-size: 14px;
    font-weight: 600;
}

QFrame#kpi_card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

QFrame#filter_bar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

QFrame#segmented_control {
    background-color: #F8FAFC;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 2px;
}

QPushButton#seg_btn {
    background-color: transparent;
    color: #6B7280;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 0 12px;
    min-height: 28px;
}

QPushButton#seg_btn:checked {
    background-color: #C8102E;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#seg_btn:hover:!checked {
    background-color: #F3F4F6;
    color: #111827;
}

/* ============================================================================
   CONTROLES DE ENTRADA
============================================================================ */
QComboBox {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 0px 28px 0px 12px;
    min-height: 36px;
    max-height: 38px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #9CA3AF;
}

QComboBox:focus {
    border: 1.5px solid #C8102E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(assets/images/chevron_down.png);
    width: 12px;
    height: 12px;
    border: none;
}

QComboBox QLineEdit {
    min-height: 0px;
    max-height: 36px;
    padding: 0px 2px;
    margin: 0px;
    border: none;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #111827;
    selection-background-color: #F8FAFC;
    selection-color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 10px;
    color: #111827;
    background-color: #FFFFFF;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #F8FAFC;
    color: #111827;
}

QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 0px 12px;
    min-height: 36px;
    max-height: 38px;
    font-size: 13px;
    selection-background-color: #E5E7EB;
    selection-color: #111827;
}

QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    min-height: 76px;
    font-size: 13px;
    selection-background-color: #E5E7EB;
    selection-color: #111827;
}

QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #C8102E;
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #9CA3AF;
}

/* ============================================================================
   TABLAS Y LISTADOS CORPORATIVOS
============================================================================ */
QTableWidget, QTreeWidget, QTableView {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    outline: none;
    gridline-color: transparent;
    font-size: 13px;
}

QTreeWidget::item, QTableWidget::item, QTableView::item {
    background-color: #FFFFFF;
    color: #111827;
    padding: 0px 10px;
    min-height: 50px;
    border-bottom: 1px solid #F3F4F6;
    font-size: 12.5px;
}

QTreeWidget::item:hover, QTableWidget::item:hover, QTableView::item:hover {
    background-color: #F8FAFC;
}

QTreeWidget::item:selected, QTableWidget::item:selected, QTableView::item:selected {
    background-color: #F8FAFC;
    color: #111827;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #F9FAFB;
    color: #6B7280;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 0px 10px;
    height: 40px;
    min-height: 40px;
}

/* ============================================================================
   BOTONES CORPORATIVOS
============================================================================ */
QPushButton {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12.5px;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #F3F4F6;
}

QPushButton:disabled {
    background-color: #F8FAFC;
    color: #9CA3AF;
    border: 1px solid #E5E7EB;
}

QPushButton[class="primary"], QPushButton#btn_primary {
    background-color: #C8102E;
    color: #FFFFFF;
    border: 1px solid #C8102E;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[class="primary"]:hover, QPushButton#btn_primary:hover {
    background-color: #A60D26;
    border-color: #A60D26;
}

QPushButton#btn_action_pdf,
QPushButton#btn_action_edit,
QPushButton#btn_action_more {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11.5px;
    font-weight: 600;
    min-height: 28px;
}

QPushButton#btn_action_pdf:hover,
QPushButton#btn_action_edit:hover,
QPushButton#btn_action_more:hover {
    background-color: #F8FAFC;
    border-color: #9CA3AF;
}

/* ============================================================================
   MENÚS Y BARRA DE ESTADO
============================================================================ */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px;
    font-size: 12.5px;
}

QMenu::item {
    padding: 7px 14px;
    border-radius: 6px;
    color: #111827;
}

QMenu::item:selected {
    background-color: #F8FAFC;
}

QMenu::separator {
    height: 1px;
    background-color: #F3F4F6;
    margin: 4px 8px;
}

QStatusBar {
    background: #FFFFFF;
    color: #6B7280;
    border-top: 1px solid #E5E7EB;
    font-size: 11px;
    padding: 2px 10px;
}

QToolTip {
    background-color: #111827;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}
