# ══════════════════════════════════════════════════════════════════════════════
# pesa_api — plantilla de variables de entorno (desarrollo local)
# En Render se configuran en: Dashboard → pesa-api → Environment.
# Copia a `pesa_api/.env` (NO se sube a GitHub).
# ══════════════════════════════════════════════════════════════════════════════

# Cadena completa (Render la usa en producción)
DATABASE_URL=

# Alternativa por partes (solo si no hay DATABASE_URL)
PESA_DB_HOST=127.0.0.1
PESA_DB_PORT=5432
PESA_DB_NAME=pesa_db
PESA_DB_USER=
PESA_DB_PASSWORD=
PESA_DB_MIN_CONN=1
PESA_DB_MAX_CONN=10

# Clave de firma JWT — OBLIGATORIA en producción (cadena aleatoria larga)
PESA_JWT_SECRET=
PESA_JWT_EXPIRE_MINUTES=43200
PESA_REFRESH_EXPIRE_DAYS=7

PESA_FILES_PATH=
PESA_LOG_LEVEL=INFO
